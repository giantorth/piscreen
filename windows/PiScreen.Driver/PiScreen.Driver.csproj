<Project Sdk="Microsoft.NET.Sdk">
  <!--
    SimHub MMF screen driver. SimHub launches <SimHub>\SharedDrivers\PiScreen\DisplayDriver.exe itself.
    net48 because SimHub's own runtime is guaranteed to be there (Windows and its Wine prefix);
    x64 because the OpenH264 binding is written for the x64 ABI.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>DisplayDriver</AssemblyName>
    <RootNamespace>PiScreen</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="SharpZipLib" Version="1.4.2" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- Dev builds: Cisco OpenH264 from scripts/fetch-openh264.sh (never committed). Release zips
       leave it out; the driver then downloads it from Cisco on first run (OpenH264Provider). -->
  <ItemGroup>
    <None Include="../third_party/openh264-*-win64.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
</Project>
